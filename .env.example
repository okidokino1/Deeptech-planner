# ── 딥테크 플래너 환경변수 ─────────────────────────────────────────────
# 아무 것도 설정하지 않아도 "데모 모드"로 전체 앱이 동작합니다.
# 아래 키를 채우면 각 기능이 실제 서비스로 자동 전환됩니다.
# 이 파일을 복사해 .env.local 로 저장하세요. (로컬) / Vercel은 Project Settings에 등록.

# 1) Supabase (계정·DB·저장) — https://supabase.com
#    새 프로젝트 생성 → SQL Editor에서 supabase/setup-all.sql 실행
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2) Anthropic Claude (AI 기획·계획서·발표채점) — https://console.anthropic.com
#    품질을 최대로 하려면 CLAUDE_MODEL=claude-opus-4-8 권장 (기본은 비용 효율 모델)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# 3) OpenAI Whisper (발표 음성→텍스트) — https://platform.openai.com  (선택)
OPENAI_API_KEY=

# 4) PortOne (국내 카드·간편결제) — https://portone.io
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# 5) 인증번호 발송 (Solapi) — https://solapi.com  (선택: 없으면 가입 시 코드 화면표시)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=        # 발신번호(숫자만 예: 01012345678)
SOLAPI_PFID=          # 카카오 채널(플러스친구) ID
SOLAPI_TEMPLATE_ID=   # 알림톡 템플릿 ID (본문에 #{code} 포함, 카카오 승인 필요)

# 6) 관리자 (선택) — 무제한 이용, 콤마로 여러 명
ADMIN_EMAILS=okidokino1@gmail.com
